# Secrets + live state — NEVER commit
# config/config.php holds server_secret (cert-signing key) + db creds
config/config.php
# live SQLite DB, journals, wal/shm sidecars — keep only the directory
data/*
!data/.gitkeep

# user uploads (catalog images, update zips) — keep the .htaccess guard
uploads/*
!uploads/.htaccess

# OS / editor cruft
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.log
